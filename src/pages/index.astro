---
/**
 * Home page: pulls the newest content from four collections at once.
 * Promise.all runs the four database queries in parallel instead of one after another.
 */
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import MediaCard from "../components/MediaCard.astro";
import PostCard from "../components/PostCard.astro";
import { formatDate } from "../utils/media-url";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/collections.css";

const newest = { orderBy: { published_at: "desc" } } as const;

const [photosResult, pressResult, videosResult, postsResult, settings] = await Promise.all([
	getEmDashCollection("photos", { ...newest, limit: 7 }),
	getEmDashCollection("press", { ...newest, limit: 3 }),
	getEmDashCollection("videos", { ...newest, limit: 3 }),
	getEmDashCollection("posts", { ...newest, limit: 3 }),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

// Tell the cache which database rows this page used, so it refreshes when they change.
if (Astro.cache?.enabled) {
	for (const r of [photosResult, pressResult, videosResult, postsResult]) {
		Astro.cache.set(r.cacheHint);
	}
}

// The newest photo becomes the hero; the rest fill the grid below it.
const [heroPhoto, ...gridPhotos] = photosResult.entries;
const releases = pressResult.entries;
const videos = videosResult.entries;
const posts = postsResult.entries;
const isEmpty = !heroPhoto && !releases.length && !videos.length && !posts.length;
---

<Base title={siteTitle} description={siteTagline}>
	{
		isEmpty ? (
			<section class="lf-page">
				<h1 class="lf-page-title">Nothing published yet</h1>
				<p class="lf-empty">
					<a href="/_emdash/admin">Open the admin</a> and publish your first photo.
				</p>
			</section>
		) : (
			<div class="lf-page">
				{heroPhoto && (
					<section class="hero">
						<a href={`/photos/${heroPhoto.id}`} class="hero-image" {...heroPhoto.edit.image}>
							{heroPhoto.data.image && <Image image={heroPhoto.data.image} priority />}
						</a>
						<div class="hero-text">
							<p class="lf-card-eyebrow">Latest photo</p>
							<h1 class="hero-title">
								<a href={`/photos/${heroPhoto.id}`} {...heroPhoto.edit.title}>{heroPhoto.data.title}</a>
							</h1>
							{heroPhoto.data.caption && <p class="lf-detail-lede">{heroPhoto.data.caption}</p>}
							<p class="hero-tagline">{siteTagline}</p>
						</div>
					</section>
				)}

				{gridPhotos.length > 0 && (
					<section class="home-section">
						<header class="section-header">
							<h2 class="section-title">Recent photos</h2>
							<a href="/photos" class="section-link">View all</a>
						</header>
						<div class="lf-grid">
							{gridPhotos.map((photo) => (
								<MediaCard
									title={photo.data.title}
									href={`/photos/${photo.id}`}
									image={photo.data.image}
									shape="square"
									editImage={photo.edit.image}
									editTitle={photo.edit.title}
								/>
							))}
						</div>
					</section>
				)}

				{releases.length > 0 && (
					<section class="home-section">
						<header class="section-header">
							<h2 class="section-title">Press</h2>
							<a href="/press" class="section-link">View all</a>
						</header>
						<div class="lf-grid">
							{releases.map((release) => (
								<MediaCard
									title={release.data.title}
									href={`/press/${release.id}`}
									image={release.data.headline_image}
									label={formatDate(release.data.publishedAt)}
									blurb={release.data.summary}
									editImage={release.edit.headline_image}
									editTitle={release.edit.title}
								/>
							))}
						</div>
					</section>
				)}

				{videos.length > 0 && (
					<section class="home-section">
						<header class="section-header">
							<h2 class="section-title">Videos</h2>
							<a href="/videos" class="section-link">View all</a>
						</header>
						<div class="lf-grid">
							{videos.map((video) => (
								<MediaCard
									title={video.data.title}
									href={`/videos/${video.id}`}
									image={video.data.poster}
									blurb={video.data.description}
									isVideo
									editImage={video.edit.poster}
									editTitle={video.edit.title}
								/>
							))}
						</div>
					</section>
				)}

				{posts.length > 0 && (
					<section class="home-section">
						<header class="section-header">
							<h2 class="section-title">From the journal</h2>
							<a href="/posts" class="section-link">View all</a>
						</header>
						<div class="lf-grid">
							{posts.map((post) => (
								<PostCard
									title={post.data.title}
									excerpt={post.data.excerpt}
									featuredImage={post.data.featured_image}
									href={`/posts/${post.id}`}
									date={post.data.publishedAt ?? undefined}
									readingTime={getReadingTime(post.data.content)}
									bylines={post.data.bylines ?? []}
									edit={post.edit}
								/>
							))}
						</div>
					</section>
				)}
			</div>
		)
	}
</Base>

<style>
	/* Hero: big photo on the left, text on the right (stacks on phones) */
	.hero {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: var(--spacing-8);
		align-items: center;
		margin-bottom: var(--spacing-16);
	}

	.hero-image {
		display: block;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.hero-image :global(img) {
		width: 100%;
		height: auto;
		max-height: 70vh;
		object-fit: cover;
		display: block;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.lf-card-eyebrow {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
	}

	.hero-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.hero-title a {
		color: inherit;
		text-decoration: none;
	}

	.hero-title a:hover {
		color: var(--color-brand);
	}

	.hero-tagline {
		color: var(--color-muted);
	}

	.home-section {
		margin-bottom: var(--spacing-16);
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-title {
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
	}

	.section-link {
		font-size: var(--font-size-sm);
		color: var(--color-brand);
		text-decoration: none;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			gap: var(--spacing-6);
		}
	}
</style>
