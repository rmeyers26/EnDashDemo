---
/**
 * /press : press releases, newest first.
 * Drafts (like the sample "Draft: First Gallery Show") are NOT returned here,
 * because getEmDashCollection only returns published entries to normal visitors.
 */
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import MediaCard from "../../components/MediaCard.astro";
import { formatDate } from "../../utils/media-url";
import "../../styles/collections.css";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: releases, cacheHint, nextCursor } = await getEmDashCollection("press", {
	orderBy: { published_at: "desc" },
	limit: 24,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Press" description="Press releases and announcements">
	<div class="lf-page">
		<header class="lf-page-header">
			<h1 class="lf-page-title">Press</h1>
			<p class="lf-page-sub">Announcements and press releases</p>
		</header>

		{
			releases.length === 0 ? (
				<p class="lf-empty">
					No press releases yet. <a href="/_emdash/admin/content/press/new">Write one in the admin.</a>
				</p>
			) : (
				<div class="lf-grid">
					{releases.map((release) => (
						<MediaCard
							title={release.data.title}
							href={`/press/${release.id}`}
							image={release.data.headline_image}
							label={formatDate(release.data.publishedAt)}
							blurb={release.data.summary}
							editImage={release.edit.headline_image}
							editTitle={release.edit.title}
						/>
					))}
				</div>
			)
		}

		<nav class="lf-pagination" aria-label="Pagination">
			{cursor && <a href="/press">First page</a>}
			{nextCursor && <a href={`/press?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>}
		</nav>
	</div>
</Base>
