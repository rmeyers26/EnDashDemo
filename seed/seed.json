{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Lensfolio",
		"description": "A photography hobby site: photos, press releases, videos and a journal",
		"author": "Lensfolio"
	},
	"settings": {
		"title": "Lensfolio",
		"tagline": "Frames, field notes and press releases from a hobby photographer"
