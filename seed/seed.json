						"allowedMimeTypes": [
							"image/jpeg",
							"image/png",
							"image/webp"
						]
					}
				},
				{
					"slug": "caption",
					"label": "Caption",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "location",
					"label": "Location",
					"type": "string"
				},
				{
					"slug": "camera",
					"label": "Camera",
					"type": "string"
				},
				{
					"slug": "lens",
